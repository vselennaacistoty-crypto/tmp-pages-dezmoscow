# Статический сайт, собранный Next.js (output: export, trailingSlash: false).
#
# Зачем это нужно. Для города Балашиха сборка создаёт ОДНОВРЕМЕННО
# файл balashikha.html и папку balashikha/ (в ней страницы услуг города).
# Apache по умолчанию видит папку, редиректит /balashikha на /balashikha/
# и отдаёт 404, потому что index.html внутри папки нет.
# Ниже это чинится: сначала пробуем отдать одноимённый .html, и только
# потом всё остальное.

Options -Indexes -MultiViews
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Сайт живёт на адресе БЕЗ www. Хостинг отдаёт www-версию полноценным
  # зеркалом (200 на каждой странице), а для поисковика это второй такой же
  # сайт — прямая причина дублей. Склеиваем 301-м. Правило стоит ПЕРВЫМ:
  # ниже идут правила с [L], которые иначе отдали бы файл прямо с www-адреса.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Хвост взлома: подставные адреса вида /?d=<15 символов> ещё висят в индексе
  # Google (их было 2077). Уводим 301-м на чистый адрес — иначе каждая такая
  # ссылка остаётся отдельной копией страницы.
  RewriteCond %{QUERY_STRING} (^|&)d=[a-z0-9]{15}($|&) [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI}? [R=301,L]

  # /podolsk/unichtozhenie-klopov/ → без слэша, чтобы не плодить дубли
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ https://%{HTTP_HOST}%1 [R=301,L]

  # уже существующий файл отдаём как есть
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # /balashikha → balashikha.html (главнее папки с тем же именем)
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Города, которых больше нет в структуре: уводим на общий адрес
  RewriteRule ^(khimki|lyubertsy|mytischi)/(.+)$ https://%{HTTP_HOST}/$2 [R=301,L]
  RewriteRule ^(khimki|lyubertsy|mytischi)/?$ https://%{HTTP_HOST}/ [R=301,L]

</IfModule>

ErrorDocument 404 /404.html

# ── кэш и сжатие ────────────────────────────────────────────────

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/x-icon             "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType text/css                 "access plus 1 month"
  ExpiresByType application/javascript   "access plus 1 month"
  ExpiresByType text/html                "access plus 10 minutes"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
